{
  "name": "readytogoapp",
  "main": "index.ts",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:android:share": "eas build --platform android --profile share",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "build:android:local": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-apk.ps1",
    "apk:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-apk.ps1",
    "apk:link": "eas build:list --platform android --limit 1 --json",
    "android:sha1": "cd android && gradlew.bat signingReport",
    "android:maps-log": "powershell -NoProfile -Command \"$adb = Join-Path ($env:ANDROID_HOME ?? (Join-Path $env:LOCALAPPDATA 'Android\\Sdk')) 'platform-tools\\adb.exe'; if (-not (Test-Path $adb)) { Write-Error 'adb not found. Install Android SDK platform-tools.'; exit 1 }; & $adb logcat -s 'Google Maps Android API:V' 'GoogleMapsSDK:V' '*:E'\""
  },
  "dependencies": {
    "@expo-google-fonts/google-sans": "^0.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/drawer": "^7.10.3",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/stack": "^7.9.2",
    "@reduxjs/toolkit": "^2.12.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "iso-639-1": "^3.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.76.0",
    "react-native": "0.86.3",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-maps": "1.27.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "ionicons": "^7.1.0",
    "leaflet": "^1.9.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
