# Mobile API v1 — include /api/v1 in the base URL
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Production: https://earthquickalert.vercel.app/api/v1
# Physical device on LAN: http://192.168.x.x:3000/api/v1

EXPO_PUBLIC_APP_ENV=development

# Google Maps — REQUIRED for address search dropdown on mobile.
#
# Web and mobile need DIFFERENT key restrictions in Google Cloud Console:
#   Web key  → Application restriction: HTTP referrers (your website)
#   Mobile key → Application restriction: None (dev/Expo Go) OR Android/iOS apps
#
# Use the MOBILE key below (NOT the website-only key):
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_mobile_google_maps_api_key_here
#
# Also set for native map SDK (Android/iOS) — use the SAME mobile key:
GOOGLE_MAPS_API_KEY=your_mobile_google_maps_api_key_here
#
# Enable in Google Cloud: Places API, Geocoding API, Maps SDK for Android/iOS.
# After changing .env: npx expo start -c
#
# Optional: if your Next.js web app exposes /api/places/autocomplete, set:
# EXPO_PUBLIC_PLACES_AUTOCOMPLETE_URL=https://your-domain.com/api/places/autocomplete?input=
